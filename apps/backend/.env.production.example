# apps/backend/.env.production — secretos y config propios del backend en el
# servidor, vía `env_file` (docker-compose.prod.yml). DATABASE_URL y PORT NO
# van aquí: los fija docker-compose.prod.yml (ver comentarios ahí y en el
# .env.example de la raíz).
#
#   cp .env.production.example .env.production

# URL pública por la que se alcanza a ESTE backend (detrás del reverse proxy).
BETTER_AUTH_URL=https://api-asistencia.elineas.com

# Origen público del frontend: better-auth lo usa para CORS/trustedOrigins.
FRONTEND_URL=https://asistencia.elineas.com

# bunx --bun @better-auth/cli secret
BETTER_AUTH_SECRET=
