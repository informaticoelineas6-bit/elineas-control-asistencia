# apps/backend/.env.production — secretos y config propios del backend en el
# servidor, vía `env_file` (docker-compose.prod.yml). DATABASE_URL y PORT NO
# van aquí: los fija docker-compose.prod.yml (ver comentarios ahí y en el
# .env.example de la raíz).
#
#   cp .env.production.example .env.production

# Identity Server de Elineas (spec 00 §C.8).
AUTH_API_URL=https://auth.elineas.com
SYSTEM_SLUG=control-asistencia

# Origen público del frontend: se usa para CORS con credenciales. Este mismo
# origen debe estar dado de alta en `ALLOWED_ORIGIN` del Identity Server
# (RN-00.34) o el navegador bloqueará las peticiones.
FRONTEND_URL=https://asistencia.elineas.com

ROLES_CACHE_TTL_MS=300000
ROLES_STALE_GRACE_MS=3600000

# Reportería mensual (spec 16 §3). REPORTS_DIR lo fija docker-compose.prod.yml
# (apunta al volumen `reports`); aquí sólo va el secreto de firma.
#
# Sin él, los enlaces de descarga se firman con un secreto aleatorio por
# proceso: siguen siendo seguros, pero un redespliegue invalida los que alguien
# acaba de recibir (RN-16.5). Genéralo una vez y no lo cambies:
#   openssl rand -hex 32
REPORT_DOWNLOAD_SECRET=

# Tiempo tras el que una corrida colgada se marca como fallida (RN-16.8).
REPORT_RUN_TIMEOUT_MS=900000
