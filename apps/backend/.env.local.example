DATABASE_URL="postgresql://elineas:elineas@localhost:5434/elineas_control_asistencia"

# Identity Server de Elineas (spec 00 §C.8). Este sistema NO almacena
# contraseñas ni las verifica: sólo habla con el IS.
#
# En local es el contenedor `elineas-auth-api` (compose de ~/dev/elineas-auth),
# publicado en el 8081 del host. Levántalo antes: sin IS no hay logins.
#   cd ~/dev/elineas-auth && docker compose up -d
AUTH_API_URL=http://localhost:8081
SYSTEM_SLUG=control-asistencia

# TTL de la caché de roles (RN-00.41): lo que tarda en aplicarse aquí un cambio
# de rol hecho en la consola del IS.
ROLES_CACHE_TTL_MS=300000
# Ventana en la que se siguen sirviendo roles cacheados si el IS no responde
# (RN-00.42), para que la gente pueda seguir fichando.
ROLES_STALE_GRACE_MS=3600000

FRONTEND_URL=http://localhost:3004
PORT=3001

# Reportería mensual (spec 16 §3): dónde quedan los XLSX generados. En local,
# un directorio del proyecto (está en .gitignore); en el servidor lo fija
# docker-compose.prod.yml apuntando a un volumen.
REPORTS_DIR=./data/reports
