# .env RAÍZ — lo lee `docker compose`, para interpolar ${VAR} dentro de los
# `docker-compose*.yml`. NUNCA llega a los contenedores: cada app recibe sus
# propias variables desde `apps/<app>/.env.local` o `.env.production` vía
# `env_file`.
#
#   cp .env.example .env
#
# Cópialo a `.env` (ya está en .gitignore, no se commitea).

# ── Postgres — docker-compose.yml (local/dev) ──────────────────────
# Credenciales del postgres:16-alpine que ese compose crea. El backend
# construye su DATABASE_URL a partir de estas, apuntando al servicio
# `postgres` (ver docker-compose.yml). POSTGRES_HOST_PORT es el puerto en el
# que se publica hacia el host, solo para herramientas de GUI.
POSTGRES_USER=elineas
POSTGRES_PASSWORD=elineas
POSTGRES_DB=elineas_control_asistencia
POSTGRES_HOST_PORT=5434

# ── Postgres — docker-compose.prod.yml (servidor) ──────────────────
# Prod NO crea su propio contenedor Postgres: apunta a uno YA EXISTENTE en el
# servidor, alcanzado POR NOMBRE sobre `elineas_default` — la red del
# proyecto `elineas` (ver DEPLOY.md). Esa red no la crea este compose, solo
# se consume como external.
# POSTGRES_HOST es el container_name (o alias de red) del Postgres existente.
# POSTGRES_USER/PASSWORD deben ser las credenciales REALES de ese contenedor.
# El nombre de la base ("elineas_control_asistencia") está fijado en
# docker-compose.prod.yml, no aquí — créala a mano antes del primer `up`
# (ver DEPLOY.md § 1).
POSTGRES_HOST=elineas-db
POSTGRES_PORT=5432

# ── Frontend — docker-compose.prod.yml (build arg) ─────────────────
# Se incrusta en el bundle del cliente al construir la imagen (Vite lo
# reemplaza como literal): URL pública por la que el navegador del usuario
# alcanza al backend. Cambiarla exige `docker compose -f docker-compose.prod.yml up -d --build frontend`.
VITE_BACKEND_URL=https://api-asistencia.elineas.com

# ── Puertos publicados en el servidor (docker-compose.prod.yml) ────
BACKEND_PORT=3001
FRONTEND_PORT=3004
