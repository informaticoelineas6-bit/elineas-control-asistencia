{
  "name": "elineas-control-asistencia",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "build": "bun run --filter frontend build",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "bun run --filter backend db:generate",
    "db:migrate": "bun run --filter backend db:migrate",
    "db:push": "bun run --filter backend db:push",
    "db:pull": "bun run --filter backend db:pull",
    "db:studio": "bun run --filter backend db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2"
  }
}
